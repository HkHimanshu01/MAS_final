{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint",
  "description": "Agent 1a investigation output. Lightweight — captures findings so Agent 1b can synthesise diagnosis.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis",
    "confidence",
    "files_examined",
    "affected_files",
    "call_chain",
    "supporting_evidence",
    "unknowns",
    "introducing_commit",
    "next_best_action"
  ],
  "properties": {
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "files_examined": {
      "type": "array",
      "items": { "type": "string" }
    },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "call_chain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "lines", "note"],
        "properties": {
          "type": { "type": "string" },
          "path": { "type": "string" },
          "lines": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "rejected_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "introducing_commit": {
      "type": ["string", "null"]
    },
    "next_best_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
