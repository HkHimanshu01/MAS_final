{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Solution",
  "description": "Agent 2 fix proposal output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "recommendation",
    "no_fix_reason",
    "recommended_fix_id",
    "fixes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "enum": ["FIX", "NO_FIX"]
    },
    "no_fix_reason": {
      "type": ["string", "null"]
    },
    "recommended_fix_id": {
      "type": ["string", "null"]
    },
    "fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "why_this_fixes_root_cause",
          "unified_diff",
          "affected_files",
          "risk",
          "expected_tests",
          "manual_review_notes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "why_this_fixes_root_cause": { "type": "string", "minLength": 1 },
          "unified_diff": { "type": "string", "minLength": 1 },
          "affected_files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "risk": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "expected_tests": {
            "type": "array",
            "items": { "type": "string" }
          },
          "manual_review_notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "if": {
    "properties": { "recommendation": { "const": "FIX" } }
  },
  "then": {
    "properties": {
      "fixes": { "minItems": 1 },
      "recommended_fix_id": { "type": "string", "minLength": 1 }
    }
  }
}
