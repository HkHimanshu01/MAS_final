{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation",
  "description": "Agent 2.5 worktree validation output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "status",
    "worktree_path",
    "applied_patch",
    "generated_test",
    "test_command",
    "commands_run",
    "failures",
    "regression_risk",
    "notes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SKIPPED",
        "PATCH_APPLIED",
        "TEST_CREATED",
        "TESTS_PASSED",
        "TESTS_FAILED",
        "GENERATED_BUT_NOT_VERIFIED",
        "VALIDATION_FAILED",
        "NOT_RUN_NO_COMMAND"
      ]
    },
    "worktree_path": {
      "type": ["string", "null"]
    },
    "applied_patch": {
      "type": "boolean"
    },
    "generated_test": {
      "type": "boolean"
    },
    "test_command": {
      "type": ["string", "null"]
    },
    "commands_run": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "regression_risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
