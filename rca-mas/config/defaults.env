# RCA MAS — All tunable parameters in one place.
# Override any value by exporting before running:
#   RCA_MODEL=claude-opus-4-7 ./rca-mas.sh bug.md

# --- Turn budgets (by repo file count tier) ---
RCA_TURNS_XS=15
RCA_TURNS_S=25
RCA_TURNS_M=35
RCA_TURNS_L=50

# --- Wall-clock timeouts in seconds (by tier) ---
RCA_TIMEOUT_XS=180
RCA_TIMEOUT_S=300
RCA_TIMEOUT_M=420
RCA_TIMEOUT_L=600

# --- File count breakpoints for tier selection ---
RCA_TIER_XS=100
RCA_TIER_S=500
RCA_TIER_M=2000

# --- Agent 2 ---
RCA_AGENT2_TURNS=1
RCA_AGENT2_TIMEOUT=180

# --- Agent 2.5 ---
RCA_AGENT25_TURNS=15
RCA_AGENT25_TIMEOUT=300
RCA_AGENT25_TEST_TIMEOUT=120

# --- Confidence thresholds ---
RCA_CONFIDENCE_STOP=0.7
RCA_CONFIDENCE_NOFX=0.5
RCA_CONFIDENCE_CHECKPOINT=0.4

# --- Git history lookback ---
RCA_GIT_LOOKBACK="14 days ago"

# --- Collector limits ---
RCA_ERROR_GREP_LIMIT=50
RCA_COLLECTOR_TIMEOUT=30

# --- Output directories ---
RCA_OUTPUT_DIR=".rca-mas"
RCA_WORKTREE_DIR="../.rca-mas-worktrees"
RCA_KEEP_WORKTREE=0

# --- Model (empty = claude-sonnet-4-6) ---
RCA_MODEL=""

# --- Cost warning thresholds ---
RCA_COST_WARN_SECONDS=480
RCA_COST_WARN_AGENT1_TURNS=40
