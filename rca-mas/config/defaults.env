# AI-Powered Bug Diagnosis and Resolution. All tunable parameters in one place.
# Override any value by exporting before running:
#   RCA_MODEL=claude-opus-4-7 ./rca-mas.sh bug.md
#
# Every section below has a "Tune:" line telling you when to raise or lower
# the values. Defaults are sized for the 80th percentile repo.

# --- Per-agent cost caps (USD). Cost cap is the primary throttle; --max-turns
# is an emergency backstop only. Set to 0 to disable.
# Tune: raise for genuinely hard bugs where the agents are spending many turns.
# Lower if you want a tighter budget per investigation.
RCA_A1A_BUDGET_USD=10
RCA_A1B_BUDGET_USD=10
RCA_AGENT2_BUDGET_USD=10

# --- Agent 1a (investigation phase) turn budgets by repo tier ---
# max_turns is a backstop. Agent 1a writes FINAL FINDINGS when confident,
# not when forced. Cost cap is the real limit.
# Tune: raise for repos where the agent runs out of turns before concluding
# (rare with the current ceiling). Lower if you want a faster forced exit.
RCA_A1A_TURNS_XS=200
RCA_A1A_TURNS_S=200
RCA_A1A_TURNS_M=200
RCA_A1A_TURNS_L=200

# --- Agent 1a wall-clock timeouts in seconds (by tier) ---
# All tiers use 15 min, enough for any investigation, keeps costs predictable.
# Tune: raise per tier for monorepos with 10k+ files. Lower if you want a hard
# wall-clock budget per stage.
RCA_A1A_TIMEOUT_XS=900
RCA_A1A_TIMEOUT_S=900
RCA_A1A_TIMEOUT_M=900
RCA_A1A_TIMEOUT_L=900

# --- Agent 1b (conclusion phase) turn budgets and timeouts ---
# Schema-enforced. Reads checkpoint, synthesises JSON. Cost cap is primary limit.
# Tune: rarely changed. Raise timeout if the synthesis step is being killed.
RCA_A1B_TURNS=20
RCA_A1B_TIMEOUT=120

# --- Legacy turn-count aliases (kept for external scripts that read RCA_TURNS_*) ---
RCA_TURNS_XS="${RCA_A1A_TURNS_XS}"
RCA_TURNS_S="${RCA_A1A_TURNS_S}"
RCA_TURNS_M="${RCA_A1A_TURNS_M}"
RCA_TURNS_L="${RCA_A1A_TURNS_L}"
RCA_TIMEOUT_XS="${RCA_A1A_TIMEOUT_XS}"
RCA_TIMEOUT_S="${RCA_A1A_TIMEOUT_S}"
RCA_TIMEOUT_M="${RCA_A1A_TIMEOUT_M}"
RCA_TIMEOUT_L="${RCA_A1A_TIMEOUT_L}"
# Note: all timeout values are 900s. Override per-tier if needed:
#   RCA_A1A_TIMEOUT_L=1800 ./rca-mas.sh bug.md

# --- File count breakpoints for tier selection ---
# Repos with file count below RCA_TIER_XS use XS settings, below RCA_TIER_S
# use S settings, and so on. Anything above RCA_TIER_M is treated as L.
# Tune: raise if you mostly work on huge repos and want the L tier to kick in
# later. Lower for the opposite.
RCA_TIER_XS=100
RCA_TIER_S=500
RCA_TIER_M=2000

# --- Agent 2 (fix synthesis) ---
# Matches Agent 1b's locked pattern: --json-schema enforced, --tools flag
# omitted (defaults are technically enabled but the system prompt forbids
# tool use; the model has been compliant across the locked Agent 1 verification).
# Cost cap is the primary throttle; --max-turns is an emergency backstop only.
# 600s timeout: 300s was too tight for complex multi-part fixes (Bug 3: two
# interacting commits, 5 evidence points, detailed diff). 180s was the original
# value, raised to 300s, raised again to 600s after Bug 3 hit exit 124.
# Tune: raise timeout if Agent 2 is timing out on very large diffs. Raise turns
# if the fix needs more than one shot at synthesis.
RCA_AGENT2_TURNS=20
RCA_AGENT2_TIMEOUT=600

# --- Agent 2.5 (verify stage, --validate only) ---
# RCA_AGENT25_TIMEOUT is the overall wall-clock budget for the verify agent.
# RCA_AGENT25_TEST_TIMEOUT is the cap for a single `pytest` (or jest etc) call.
# Defaults sized for the 80th percentile repo: covers click-class, Flask-class
# and Django-class projects up to roughly 3000 to 5000 sequential tests.
# Tune: raise both for monorepos with 5000+ integration tests or slow setup.
# Lower if your suite is fast (pure unit) and you want a tighter circuit-breaker.
RCA_AGENT25_TURNS=15
RCA_AGENT25_TIMEOUT=1800
RCA_AGENT25_TEST_TIMEOUT=1200

# --- Confidence thresholds ---
# STOP: Agent 1 stops early when its confidence exceeds this.
# NOFX: Agent 2 emits NO_FIX if upstream confidence is below this.
# CHECKPOINT: stamped on diagnosis after timeout recovery.
# Tune: raise NOFX and WEAK_THRESHOLD for safety-critical use where false
# fixes are worse than no fix. Lower to be more permissive about producing fixes.
RCA_CONFIDENCE_STOP=0.7
RCA_CONFIDENCE_NOFX=0.5
RCA_CONFIDENCE_CHECKPOINT=0.4
# Agent 2 marks weak_evidence=true when diagnosis.confidence is below this OR
# when upstream agent1a_quality was weak/failed. Agent 2 may still propose a FIX
# under weak evidence but caps its own confidence at 0.5 and sets risk=medium|high.
RCA_CONFIDENCE_WEAK_THRESHOLD=0.6

# --- Git history lookback ---
# How far back the briefing collects git history for mentioned files.
# Tune: widen for old bugs (e.g. "180 days ago"). Narrow for very active repos
# where 14 days already produces too much noise.
RCA_GIT_LOOKBACK="14 days ago"

# --- Collector limits ---
# ERROR_GREP_LIMIT: max lines returned per error-string grep across the repo.
# COLLECTOR_TIMEOUT: hard timeout (seconds) for each of the 4 briefing collectors.
# Tune: raise grep limit if you see "[truncated]" in briefing.md. Raise collector
# timeout for very large repos or slow disks (NFS, virtualised filesystems).
RCA_ERROR_GREP_LIMIT=50
RCA_COLLECTOR_TIMEOUT=150

# --- Output directories ---
# OUTPUT_DIR: where run artifacts land (inside the target repo).
# WORKTREE_DIR: where the verify worktree gets created (sibling of target repo).
# KEEP_WORKTREE: set to 1 to inspect the worktree after a run instead of cleaning up.
RCA_OUTPUT_DIR=".rca-mas"
RCA_WORKTREE_DIR="../.rca-mas-worktrees"
RCA_KEEP_WORKTREE=0

# --- Model (empty = claude-sonnet-4-6) ---
# Tune: set to `claude-opus-4-7` for harder bugs at higher cost. Set to
# `claude-haiku-4-5-20251001` for speed at lower quality.
RCA_MODEL=""

# --- Cost warning thresholds ---
# Logged as warnings in log.jsonl (non-blocking). Useful for spotting runaway runs.
# Tune: lower thresholds to get earlier alerts on cost overruns.
RCA_COST_WARN_SECONDS=900
RCA_COST_WARN_AGENT1_TURNS=40
